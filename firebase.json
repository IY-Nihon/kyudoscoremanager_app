{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "//": "配る直前に、dist の接続先と配り先が合っているかを確かめる。expo export は --clear を付けないとキャッシュから前回の設定を使い回すため、検証向けの束が本番へ出る事故が起きうる",
    "predeploy": ["node scripts/verify-hosting-bundle.mjs"],
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "//": "index.html は毎回取り直させる。ここが古いと、中に書かれた古いバンドルを読み続けてしまう。no-cache だけでなく no-store にするのは、Chrome を閉じて開き直したとき（前回の画面の復元）や戻る・進むが、確かめずに控えを使うため。控えそのものを残させない",
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "//": "アプリの画面の道（/record など）は index.html に回される（rewrites）が、上の2つに当たらず、何も指定が無いと Firebase の既定の max-age=3600 になる。Chrome を閉じて開き直すと、その1時間のあいだ前の版の HTML を確かめずに使い、前の版のまま動いていた（更新の帯がまた出る。2026-10-03）。道は src/MainNavigator.js の リンクの決まり と同じ（test/hostingHeaders.test.js が見張る）",
        "source": "/@(record|history|analysis|members|attendance|settings)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "//": "Service Worker 自身も毎回確認させる",
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "//": "バンドルはファイル名にハッシュが入るので長く持たせてよい",
        "source": "/_expo/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "//": "ホーム画面に追加するときの決まり（deploy-web.ps1 が pwa/manifest.json を配る）。型を明に出す。中身が変わったら拾わせたいので持たせない",
        "source": "/manifest.json",
        "headers": [
          { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "//": "アイコンは名前にハッシュが入らない。差し替えが届くよう、持たせつつ毎回確かめさせる",
        "source": "@(/apple-touch-icon*.png|/icon-*.png|/favicon.ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
      }
    ]
  }
}

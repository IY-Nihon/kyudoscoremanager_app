{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "//": "配る直前に、dist の接続先と配り先が合っているかを確かめる。expo export は --clear を付けないとキャッシュから前回の設定を使い回すため、検証向けの束が本番へ出る事故が起きうる",
    "predeploy": ["node scripts/verify-hosting-bundle.mjs"],
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "//": "index.html は毎回確認させる。ここが古いと、中に書かれた古いバンドルを読み続けてしまう",
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "//": "Service Worker 自身も毎回確認させる",
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "//": "バンドルはファイル名にハッシュが入るので長く持たせてよい",
        "source": "/_expo/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "//": "ホーム画面に追加するときの決まり（deploy-web.ps1 が pwa/manifest.json を配る）。型を明に出す。中身が変わったら拾わせたいので持たせない",
        "source": "/manifest.json",
        "headers": [
          { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "//": "アイコンは名前にハッシュが入らない。差し替えが届くよう、持たせつつ毎回確かめさせる",
        "source": "@(/apple-touch-icon.png|/icon-192.png|/icon-512.png|/favicon.ico)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
      }
    ]
  }
}

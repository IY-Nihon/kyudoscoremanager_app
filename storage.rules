rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // お問い合わせフォームからの画像添付
    // ・誰でもアップロード（作成・上書き）は可能（会員ログイン不要のため）
    // ・ただし画像ファイルのみ、10MB以下に制限
    // ・アップロード後の読み取り・削除はクライアントから不可（管理者はFirebaseコンソール/Admin SDK経由で確認）
    match /inquiries/{fileName} {
      allow write: if request.resource != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if false;
    }

    // それ以外のパスはデフォルトで拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN
EXPO_PUBLIC_FIREBASE_DATABASE_URL=YOUR_DATABASE_URL
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
# Gemini の中継（Cloudflare Workers）。鍵はアプリに置かず、中継の secret に置く
EXPO_PUBLIC_GEMINI_CHUKEI_URL=https://kyudo-gemini-chukei.kyudo-chukei.workers.dev
# 手元の計測（scripts/try-ocr.mjs）だけが直接 Gemini を呼ぶ。EXPO_PUBLIC_ を付けないので束には入らない
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

// Firestore の決まり。部員の匿名セッションを団体に紐づける（SEC-N は 2026-08-04 の見直しの番号。scripts/verify-rules.mjs が同じ番号で確かめる）
//
// 部員は signInAnonymously でログインする。匿名認証は公開APIキーだけで誰でも
// 実行できるため、request.auth != null だけでは「誰でも」とほぼ同じ。
// そこで member_lookup（個人ID→memberId の逆引き）を直接 get させ、
// その結果と一致する member_claims を作らせることで所属を証明させる。
//
// match /{document=**} は使わない。ルールは OR で合成されるため、再帰ワイルド
// カードを残すと member_lookup の list 禁止を後から引き算できないため。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 匿名ユーザーには email クレームが無いので、存在確認してから読む
    function callerEmail() {
      return (signedIn() && ('email' in request.auth.token))
        ? request.auth.token.email : '';
    }

    // 管理者。ここに載っているアドレスは、全団体の一覧・他人の団体アカウントの
    // 書き換え・削除ができる。強い権限なので、いま使っているものだけを載せる。
    //
    // 2026-09-03 に5件から1件へ減らした。本番の控えと突き合わせたところ
    //   ・3 件は口座自体が存在せず、権限だけが空振りしていた。載せたままにすると、
    //     そのアドレスで新規登録した人が管理者になれてしまう
    //   ・1 件は実在したが開発初期のもの。最終ログインは 2026-07-03、
    //     団体は持っておらず、弱いパスワードが作業用のファイルに残っていた
    //
    // 増やすときは、その口座が実在し、いま使っていることを確かめてから。
    function isAdmin() {
      return callerEmail() in [
        'nihonu.kouka@gmail.com'
      ];
    }

    // 登録メールアドレスの確認（確認メールのリンクを押した）が済んでいるか。
    // 確認が済むまで、団体は何もできない（今ある団体も。2026-11-03 本人）。偽のアドレスでは確認メールが届かない
    function verifiedEmail() {
      return callerEmail() != '' && request.auth.token.email_verified == true;
    }

    // 今ある団体の確認の猶予（配信から 1 週間。2026-11-03 本人）。この日までは、確認の済んでいない団体も今までどおり使える。
    // 新しい団体は確認が済まないと作れない（create）ので、確認の済んでいない団体は配信の前からある団体だけ。
    // 日付は src/mailKakunin.js の 猶予の終わり と同じにする（test/mailKakunin.test.js が見張る）。
    // 配信の日に「配信日＋7 日」へ書き直す（npm run deploy:rules が、近すぎ・遠すぎの日付なら止める）
    function inGracePeriod() {
      return request.time < timestamp.date(2026, 11, 10);
    }

    // 団体の確認が済んでいるか（帳面の verified）。持ち主が確認を済ませると、アプリが帳面に書く。
    // 部員はこれを見る（部員の口座は匿名でメールを持たない）
    function groupVerified(groupId) {
      return get(/databases/$(database)/documents/group_accounts/$(groupId)).data.get('verified', false) == true;
    }

    // 団体アカウント本人か（SEC-3）。確認の済んだメールで入っているときだけ
    function isGroupOwner(groupId) {
      return (verifiedEmail() || (callerEmail() != '' && inGracePeriod()))
        && get(/databases/$(database)/documents/group_accounts/$(groupId)).data.email == callerEmail();
    }

    // 所属クレーム。存在しない場合 get() は null を返す
    function claim() {
      return get(/databases/$(database)/documents/member_claims/$(request.auth.uid));
    }

    // 所属を証明済みの部員か（SEC-4）。
    // members に今も居ることを確認することで、退部・削除された部員のクレームを
    // 失効させる（SEC-7）。
    function isClaimedMember(groupId) {
      return signedIn()
        && claim() != null
        && claim().data.groupId == groupId
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(claim().data.memberId))
        && (groupVerified(groupId) || inGracePeriod());
    }

    function canAccess(groupId) {
      return isGroupOwner(groupId) || isClaimedMember(groupId);
    }

    // ログインは団体IDで行うが、Firebase Auth はメールアドレスでしか認証
    // できない。だから**認証する前に**「団体ID→メールアドレス」を引く必要が
    // あり、get は開けたままにするしかない。
    //
    // 代わりに、ここへ置くのは**ログインに要る2つだけ**にする（メールアドレスの
    // 切り替え中は、切り替え待ちのアドレス pendingEmail も置く。切り替えて 30 日は、
    // 「元に戻す」に備えて前のアドレス previousEmail と口座の番号 ownerUid も置く。
    // どれもログインに要る。src/groupLogin.js）。
    // 団体名・登録日・同意の記録を一緒に置いていたころは、6桁の団体IDを
    // 順に試すだけで「学校名とその担当者のメールアドレス」が組で集められた
    // （2026-09-02 に本番で実際に取得できることを確かめた）。
    // メールアドレス単体なら「どこかの誰か」だが、学校名と組になると
    // 「どこの誰か」になる。名寄せを止めるのがここの目的。
    //
    // 決まりは文書の一部だけを隠せない（get は文書ぜんぶを返す）ので、
    // 隠したいものは下の private へ分けてある。
    match /group_accounts/{groupId} {
      allow get: if true;                        // ログインは認証前に参照する
      // 一覧は管理者と、自分のメールの団体を引く本人だけ。1 つのメールで団体は 1 つなので、
      // Google で作るときに同じメールの団体がもう無いかを引く（src/LoginScreen.js の Googleを選ぶ。2026-11-02）。
      // 問い合わせが email == 自分のメール で絞っていないと断られる（ほかの人の団体は引けない）。
      // 引けるのは誰でも get できる 2 つ（id・email）だけなので、メールの確認済みは求めない（isGroupOwner と同じ）
      allow list: if isAdmin()
        || (callerEmail() != '' && resource.data.email == callerEmail());

      // 作れるのは、確認の済んだメールで入っている人だけ（偽のアドレスでは作れない）
      allow create: if verifiedEmail()
        && request.resource.data.email == callerEmail()
        && request.resource.data.id == groupId
        // ログインに要る2つと、確認済みの印だけ。同意の記録は private/consent へ書く
        //（src/legalDocs.js の 同意の記録。ここに混ぜると誰でも読める）
        && request.resource.data.keys().hasOnly(['id', 'email', 'verified']);

      // 更新にも hasOnly を掛ける。作るときだけ絞っても、あとから書き足せては
      // 意味がない。2026-09-03、検証環境で seed-stg.mjs が name と createdAt を
      // 書き戻せてしまい気づいた（作成は弾かれるが、更新は通っていた）。
      // ここが開いていると、団体の持ち主が自分で「学校名とメールの組」を
      // 誰でも読める場所に戻せる。
      allow update: if isAdmin()
        // 持ち主が直せるのは、ログインに要る2つと、切り替え待ちのアドレス（pendingEmail）だけ。
        // email そのものは変えさせない。切り替えは新しいアドレスの確認を通す（下の句）。
        // 直接変えられると、確かめていないアドレスに団体を渡せてしまう。
        // 前のアドレス（previousEmail）と口座の番号（ownerUid）は、消せるが書き換えられない
        || (callerEmail() != ''
            && resource.data.email == callerEmail()
            && request.resource.data.keys().hasOnly(['id', 'email', 'pendingEmail', 'previousEmail', 'ownerUid', 'verified'])
            && request.resource.data.email == resource.data.email
            // 確認済みの印を付けられるのは、確認の済んだメールで入っている本人だけ（付いている印はそのまま残せる）
            && (request.resource.data.get('verified', false) == resource.data.get('verified', false)
                || (request.resource.data.get('verified', false) == true && request.auth.token.email_verified == true))
            && request.resource.data.get('id', '') == resource.data.get('id', '')
            && (!('previousEmail' in request.resource.data)
                || request.resource.data.previousEmail == resource.data.get('previousEmail', ''))
            && (!('ownerUid' in request.resource.data)
                || request.resource.data.ownerUid == resource.data.get('ownerUid', '')))
        // 切り替えの仕上げ。確認のリンクを開いて新しいアドレスになった本人が、email を自分に
        // 書き換えて切り替え待ちを消す（src/groupLogin.js の 団体で入る）。
        // 確認済み（email_verified）でなければ通さない。通すと、切り替え待ちのアドレスで
        // 勝手に口座を作った人が団体を乗っ取れる（pendingEmail は誰でも読める）。
        // 前のアドレス（いまの email）と自分の口座の番号を残す。「元に戻す」に備える（下の句）
        || (callerEmail() != ''
            && request.auth.token.email_verified == true
            && resource.data.get('pendingEmail', '') == callerEmail()
            && request.resource.data.keys().hasOnly(['id', 'email', 'previousEmail', 'ownerUid', 'verified'])
            && request.resource.data.email == callerEmail()
            && request.resource.data.get('previousEmail', '') == resource.data.email
            && request.resource.data.get('ownerUid', '') == request.auth.uid
            && request.resource.data.get('id', '') == resource.data.get('id', ''))
        // 「元に戻す」のあと。古いアドレスに届くリンクで認証のアドレスが前のものに戻った本人が、
        // email を前のアドレスへ戻す。仕上げのときに残した口座の番号と同じ口座にしか通さない。
        // 前のアドレスで勝手に口座を作った人は、口座の番号が違うので通らない
        //（戻したあとに確認済みになるかは確かめられなかったので、email_verified には頼らない）
        || (callerEmail() != ''
            && resource.data.get('ownerUid', '') == request.auth.uid
            && resource.data.get('previousEmail', '') == callerEmail()
            && request.resource.data.keys().hasOnly(['id', 'email', 'verified'])
            && (request.resource.data.get('verified', false) == false || request.auth.token.email_verified == true)
            && request.resource.data.email == callerEmail()
            && request.resource.data.get('id', '') == resource.data.get('id', ''));

      // 消すのは管理者か、団体の持ち主本人（設定の「アカウントを削除する」。
      // src/accountDeletion.js が、写しを deleted_accounts に書いてから最後に消す）
      allow delete: if isAdmin()
        || (callerEmail() != '' && resource.data.email == callerEmail());

      // 団体名・登録日・同意の記録。**その団体のメールアドレスで入っている
      // 本人だけ**が読み書きする。親の email と突き合わせて確かめる
      match /private/{doc} {
        allow read, write: if isAdmin()
          || ((verifiedEmail() || (callerEmail() != '' && inGracePeriod()))
              && callerEmail() ==
                 get(/databases/$(database)/documents/group_accounts/$(groupId)).data.email);
      }
    }

    // 所属クレーム。逆引き表と memberId が一致する場合だけ作れる。
    // つまり正しい個人IDを知っていることが条件になる。
    match /member_claims/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      // 逆引き表の文書。個人ID（4 桁）か、招待リンクの合言葉（招待: true。src/memberInvite.js）
      function lookupEntry() {
        return get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/member_lookup/$(request.resource.data.personalId)).data;
      }
      // 招待リンクの合言葉は、期限（expiresAt。作ってから 7 日）を過ぎると使えない。
      // 期限の無い招待の文書も使えない（expiresAt が無いと評価が誤りになり、断られる）。
      // 個人ID の文書（招待を持たない）は今までどおり。すでに入っている端末は、証がもう
      // あるので期限の影響を受けない（isClaimedMember は逆引き表を見ない）
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['groupId', 'memberId', 'personalId', 'claimedAt'])
        && lookupEntry().memberId == request.resource.data.memberId
        // 確認の済んでいない団体には入れない（2026-11-03）
        && (get(/databases/$(database)/documents/group_accounts/$(request.resource.data.groupId)).data.get('verified', false) == true
            || inGracePeriod())
        && (lookupEntry().get('招待', false) != true || lookupEntry().expiresAt > request.time);
    }

    match /groups/{groupId} {
      allow get: if canAccess(groupId);
      allow create, update: if canAccess(groupId);
      allow delete: if isGroupOwner(groupId);
      // list は書かない。団体の一覧化を防ぐ（SEC-5）

      // 個人ID→memberId の逆引き。
      // get だけ許して list は禁止する。名簿を引けないようにするため（SEC-6）。
      match /member_lookup/{personalId} {
        allow get: if signedIn();
        allow list, write: if isGroupOwner(groupId);
      }

      // 部員（個人ログイン）が書けるのは、記録を作る・直すと、自分の名簿の弓具だけ。記録を消す・名簿を作る・消す・
      // ゴミ箱・卒業生・練習日は団体だけ（2026-11-02 決めた）。読むのは部員も今のまま。
      // アプリも部員にはこれらの操作を出していない（履歴の削除は管理者モード・出欠のタブは団体だけ・
      // 部員の端末は自分の弓具だけ送る src/storeMembers.js の 弓具だけ送る形）
      match /sessions/{docId} {
        allow read, create, update: if canAccess(groupId);
        allow delete: if isGroupOwner(groupId);
      }
      match /members/{docId} {
        allow read: if canAccess(groupId);
        allow create, delete: if isGroupOwner(groupId);
        allow update: if isGroupOwner(groupId)
          || (isClaimedMember(groupId)
              && docId == claim().data.memberId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equipments', 'lastModified']));
      }
      match /alumni/{docId} {
        allow read: if canAccess(groupId);
        allow write: if isGroupOwner(groupId);
      }
      match /trash/{docId} {
        allow read: if canAccess(groupId);
        allow write: if isGroupOwner(groupId);
      }
      // config のうち listing（紹介に載せてよいかの許可・2026-10-09）は、団体の持ち主だけが書ける。
      // 部員の端末から団体の答えを変えられないように。読むのは部員も可（画面には出さない）。src/listingConsent.js
      match /config/{docId} {
        allow read: if canAccess(groupId);
        allow write: if canAccess(groupId) && docId != 'listing';
      }
      match /config/listing {
        allow read: if canAccess(groupId);
        allow write: if isGroupOwner(groupId);
      }
      match /officialPracticeDays/{docId} {
        allow read: if canAccess(groupId);
        allow write: if isGroupOwner(groupId);
      }
    }

    // 消した団体アカウントの写し。設定の「アカウントを削除する」で、団体の持ち主が
    // 自分の団体の中身をここへ写してから元を消す（src/accountDeletion.js）。
    // 30日残して運営者の道具（scripts/prune-deleted-accounts.mjs）が消す。
    // 読めるのは管理者だけ。持ち主も、写したあとは読めない（消したものは戻せない）。
    // 書けるのは自分の団体IDの下だけ。group_accounts が残っているうちに書く順になっている
    match /deleted_accounts/{groupId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() || isGroupOwner(groupId);
      allow delete: if isAdmin();
      match /{sub}/{docId} {
        allow read: if isAdmin();
        allow create, update: if isAdmin() || isGroupOwner(groupId);
        allow delete: if isAdmin();
      }
    }

    // 送った時刻の控え（1 人 1 文書。2026-11-03）。お問い合わせと不具合の便りを続けて送れないようにする。
    // 書けるのは本人だけで、値は「今」（request.time）か、触らずに残すかだけ。昔の時刻にずらして回数を逃れられない
    match /rate_limits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['inquiryAt', 'reportAt'])
        && (request.resource.data.get('inquiryAt', null) == request.time
            || request.resource.data.get('inquiryAt', null) == (resource == null ? null : resource.data.get('inquiryAt', null)))
        && (request.resource.data.get('reportAt', null) == request.time
            || request.resource.data.get('reportAt', null) == (resource == null ? null : resource.data.get('reportAt', null)));
    }
    // 前に送った時刻（無ければ十分昔）から、間隔が空いているか。今送る分は、同じ一括で控えを「今」にしてあること
    function enoughGap(field, secs) {
      return getAfter(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.get(field, null) == request.time
        && (!exists(/databases/$(database)/documents/rate_limits/$(request.auth.uid))
            || get(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.get(field, timestamp.value(0)) < request.time - duration.value(secs, 's'));
    }

    // 不具合の便り。書き込みだけ許し、読み出しは誰にも許さない。
    // 送り主が自分の送ったものを読めると、他人の端末の様子まで見えてしまう。
    // 中身は src/errorReport.js が組む。氏名・的中は入れない決まり。
    match /errorReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'id', 'at', 'where', 'message', 'code', 'stack', 'trail',
             'groupId', 'role', 'version', 'device', 'online', 'count',
             'createdAt', 'expireAt'
           ])
        && request.resource.data.message is string
        && request.resource.data.message.size() < 1000
        && request.resource.data.stack.size() < 4000
        && request.resource.data.trail.size() <= 30
        && request.resource.data.device.size() < 400
        // 1 人 10 秒に 1 件まで（アプリは同じ不具合をまとめて送るので、ふつうは届かない。アプリを通さずに送る荒らしを止める）
        && enoughGap('reportAt', 10);
      allow read, update, delete: if false;
    }

    match /inquiries/{inquiryId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'email', 'content', 'imagesBase64', 'createdAt',
             'groupId', 'groupName', 'role', 'memberId', 'memberName'
           ])
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() < 5000
        // 送れるのは団体の持ち主と所属の証のある部員だけ（共有リンクの来客・匿名だけの人は送れない）・1 人 2 分に 1 件まで
        && canAccess(request.resource.data.groupId)
        && enoughGap('inquiryAt', 120);
      allow read, update, delete: if false;
    }
  }
}

// Firestore の決まり。部員の匿名セッションを団体に紐づける（SEC-N は 2026-08-04 の見直しの番号。scripts/verify-rules.mjs が同じ番号で確かめる）
//
// 部員は signInAnonymously でログインする。匿名認証は公開APIキーだけで誰でも
// 実行できるため、request.auth != null だけでは「誰でも」とほぼ同じ。
// そこで member_lookup（個人ID→memberId の逆引き）を直接 get させ、
// その結果と一致する member_claims を作らせることで所属を証明させる。
//
// match /{document=**} は使わない。ルールは OR で合成されるため、再帰ワイルド
// カードを残すと member_lookup の list 禁止を後から引き算できないため。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 匿名ユーザーには email クレームが無いので、存在確認してから読む
    function callerEmail() {
      return (signedIn() && ('email' in request.auth.token))
        ? request.auth.token.email : '';
    }

    // 管理者。ここに載っているアドレスは、全団体の一覧・他人の団体アカウントの
    // 書き換え・削除ができる。強い権限なので、いま使っているものだけを載せる。
    //
    // 2026-09-03 に5件から1件へ減らした。本番の控えと突き合わせたところ
    //   ・3 件は口座自体が存在せず、権限だけが空振りしていた。載せたままにすると、
    //     そのアドレスで新規登録した人が管理者になれてしまう
    //   ・1 件は実在したが開発初期のもの。最終ログインは 2026-07-03、
    //     団体は持っておらず、弱いパスワードが作業用のファイルに残っていた
    //
    // 増やすときは、その口座が実在し、いま使っていることを確かめてから。
    function isAdmin() {
      return callerEmail() in [
        'nihonu.kouka@gmail.com'
      ];
    }

    // 登録メールアドレスの確認（確認メールのリンクを押した）が済んでいるか。
    // 確認が済むまで、団体は何もできない（今ある団体も。2026-11-03 本人）。偽のアドレスでは確認メールが届かない
    function verifiedEmail() {
      return callerEmail() != '' && request.auth.token.email_verified == true;
    }

    // 今ある団体の確認の猶予（配信から 1 週間。2026-11-03 本人）。この日までは、確認の済んでいない団体も今までどおり使える。
    // 新しい団体は確認が済まないと作れない（create）ので、確認の済んでいない団体は配信の前からある団体だけ。
    // 日付は src/mailKakunin.js の 猶予の終わり と同じにする（test/mailKakunin.test.js が見張る）。
    // 配信の日に「配信日＋7 日」へ書き直す（npm run deploy:rules が、近すぎ・遠すぎの日付なら止める）
    function inGracePeriod() {
      return request.time < timestamp.date(2026, 11, 10);
    }

    // 使い捨てメールアドレスか（2026-11-03 本人：使い捨てのアドレスでは団体を作れない）。
    // 一覧は src/suteMail.js と同じ（test/suteMail.test.js が見張る。直すときは向こうを直して、ここへ写す）
    function disposableEmail() {
      return callerEmail().lower().matches('^.*@(.+[.])?(10minutemail[.]com|10minutemail[.]net|20minutemail[.]com|33mail[.]com|anonaddy[.]me|burnermail[.]io|byom[.]de|deadaddress[.]com|discard[.]email|disposablemail[.]com|dispostable[.]com|dropmail[.]me|emailondeck[.]com|fakeinbox[.]com|fakemail[.]net|getairmail[.]com|getnada[.]com|guerrillamail[.]biz|guerrillamail[.]com|guerrillamail[.]de|guerrillamail[.]info|guerrillamail[.]net|guerrillamail[.]org|guerrillamailblock[.]com|harakirimail[.]com|inboxbear[.]com|incognitomail[.]org|jetable[.]org|mail[-]temp[.]com|mail[.]tm|mailcatch[.]com|maildrop[.]cc|mailinator[.]com|mailinator[.]net|mailnesia[.]com|mailpoof[.]com|mailsac[.]com|mintemail[.]com|mohmal[.]com|moakt[.]com|mytemp[.]email|mytrashmail[.]com|nada[.]email|sharklasers[.]com|spam4[.]me|spamgourmet[.]com|tempail[.]com|tempinbox[.]com|tempm[.]com|tempmail[.]com|tempmail[.]dev|tempmail[.]net|tempmailo[.]com|tempmail[.]plus|temp[-]mail[.]io|temp[-]mail[.]org|temporary[-]mail[.]net|throwawaymail[.]com|trash[-]mail[.]com|trashmail[.]com|trashmail[.]de|trashmail[.]net|wegwerfmail[.]de|yopmail[.]com|yopmail[.]fr|yopmail[.]net|emltmp[.]com|mailto[.]plus|fexpost[.]com|fexbox[.]org|rover[.]info|inbox[.]lv|linshiyouxiang[.]net|tmpmail[.]org|tmpmail[.]net|tmail[.]ws|email[-]temp[.]com|1secmail[.]com|1secmail[.]org|1secmail[.]net|kzccv[.]com|qiott[.]com|wwjmp[.]com|esiix[.]com|xojxe[.]com|yoggm[.]com|bheps[.]com|dcctb[.]com|vjuum[.]com|laafd[.]com|txcct[.]com|eyepaste[.]com|mailforspam[.]com|spambox[.]us|spamfree24[.]org|mailnull[.]com|nowmymail[.]com|gishpuppy[.]com|mailexpire[.]com|tempr[.]email|discardmail[.]com|trbvm[.]com|xkx[.]me|sute[.]jp|meruado[.]uk)$');
    }

    // 使い捨てメールのドメインの一覧（disposable_domains/{ドメイン}。公開の一覧 disposable-email-domains（CC0）と
    // 日本の捨てアドを、運営の台本 scripts/sync-disposable-domains.mjs が入れる。2026-11-04）。
    // アドレスのドメインと、その上の 2 段・3 段（a.b.example.com なら b.example.com・example.com）を見る。
    // 上の正規表現（disposableEmail）は一覧を入れる前からの分で、残しておく
    function listedDomain(parts, from) {
      return parts.size() > from + 1
        && exists(/databases/$(database)/documents/disposable_domains/$(parts[from:parts.size()].join('.')));
    }
    function disposableDomain() {
      let parts = callerEmail().lower().split('@')[1].split('[.]');
      return listedDomain(parts, 0) || listedDomain(parts, 1) || listedDomain(parts, 2);
    }

    // 4 桁の個人ID を使える終わり（配信から 1 か月。2026-11-03 本人）。src/kojinId.js の 古い形を使える終わり と同じ日。
    // 新しい個人ID は、見間違えやすい字を除いた大文字と数字の 6 字（4 桁は団体ID を知れば数分で総当たりできた）
    function legacyIdUsable() {
      return request.time < timestamp.date(2026, 12, 3);
    }

    // 団体の確認が済んでいるか（帳面の verified）。持ち主が確認を済ませると、アプリが帳面に書く。
    // 部員はこれを見る（部員の口座は匿名でメールを持たない）
    function groupVerified(groupId) {
      return get(/databases/$(database)/documents/group_accounts/$(groupId)).data.get('verified', false) == true;
    }

    // 帳面がメールアドレスの切り替えの途中か（切り替え待ち pendingEmail・前のアドレス previousEmail がある）。
    // このあいだは、帳面の email の認証の口座が空いていることがある（確認のリンクを押すと、認証のアドレスは
    // 新しいほうへ移る。「元に戻す」を押すと前のほうへ戻る）。空いたアドレスでは誰でも新しく口座を作れる
    function switching(data) {
      return data.get('pendingEmail', '') != '' || data.get('previousEmail', '') != '';
    }

    // 帳面の email の本人とみなしてよい口座か（確認が要るかは呼ぶ側で見る）。切り替えの途中は、確認の済んだ口座か、
    // 切り替えを頼んだ口座（pendingUid。src/groupLogin.js の 切り替えを頼む が書く）だけ。
    // 前は email が合えば通したので、空いたアドレスで作った口座が、切り替え待ちを自分のアドレスに書き換えて
    // 団体を乗っ取れた（猶予のあいだは中身も読み書きできた。B1・2026-11-04）
    function sameOwnerAccount(data) {
      return callerEmail() != ''
        && data.email == callerEmail()
        && (!switching(data)
            || request.auth.token.email_verified == true
            || data.get('pendingUid', '') == request.auth.uid);
    }

    // 団体アカウント本人か（SEC-3）。確認の済んだメールで入っているときだけ（今ある団体は猶予のあいだも）
    function isGroupOwner(groupId) {
      return (verifiedEmail() || (callerEmail() != '' && inGracePeriod()))
        && sameOwnerAccount(get(/databases/$(database)/documents/group_accounts/$(groupId)).data);
    }

    // 所属クレーム。存在しない場合 get() は null を返す
    function claim() {
      return get(/databases/$(database)/documents/member_claims/$(request.auth.uid));
    }

    // 所属を証明済みの部員か（SEC-4）。
    // members に今も居ることを確認することで、退部・削除された部員のクレームを
    // 失効させる（SEC-7）。
    function isClaimedMember(groupId) {
      return signedIn()
        && claim() != null
        && claim().data.groupId == groupId
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(claim().data.memberId))
        // 4 桁の個人ID で入った証は、使える終わり（12/3）で止める。招待の証（32 字）・6 字の証は当たらない
        && (!string(claim().data.get('personalId', '')).matches('^[0-9]{4}$') || legacyIdUsable())
        && (groupVerified(groupId) || inGracePeriod());
    }

    function canAccess(groupId) {
      return isGroupOwner(groupId) || isClaimedMember(groupId);
    }

    // ログインは団体IDで行うが、Firebase Auth はメールアドレスでしか認証
    // できない。だから**認証する前に**「団体ID→メールアドレス」を引く必要が
    // あり、get は開けたままにするしかない。
    //
    // 代わりに、ここへ置くのは**ログインに要る2つだけ**にする（メールアドレスの
    // 切り替え中は、切り替え待ちのアドレス pendingEmail も置く。切り替えて 30 日は、
    // 「元に戻す」に備えて前のアドレス previousEmail と口座の番号 ownerUid も置く。
    // どれもログインに要る。src/groupLogin.js）。
    // 団体名・登録日・同意の記録を一緒に置いていたころは、6桁の団体IDを
    // 順に試すだけで「学校名とその担当者のメールアドレス」が組で集められた
    // （2026-09-02 に本番で実際に取得できることを確かめた）。
    // メールアドレス単体なら「どこかの誰か」だが、学校名と組になると
    // 「どこの誰か」になる。名寄せを止めるのがここの目的。
    //
    // 決まりは文書の一部だけを隠せない（get は文書ぜんぶを返す）ので、
    // 隠したいものは下の private へ分けてある。
    match /group_accounts/{groupId} {
      allow get: if true;                        // ログインは認証前に参照する
      // 一覧は管理者と、自分のメールの団体を引く本人だけ。1 つのメールで団体は 1 つなので、
      // Google で作るときに同じメールの団体がもう無いかを引く（src/LoginScreen.js の Googleを選ぶ。2026-11-02）。
      // 問い合わせが email == 自分のメール で絞っていないと断られる（ほかの人の団体は引けない）。
      // 引けるのは誰でも get できる 2 つ（id・email）だけなので、メールの確認済みは求めない（isGroupOwner と同じ）
      allow list: if isAdmin()
        || (callerEmail() != '' && resource.data.email == callerEmail());

      // 作れるのは、確認の済んだメールで入っている人だけ（偽のアドレスでは作れない）
      allow create: if verifiedEmail()
        && !disposableEmail()
        && !disposableDomain()
        // 消した団体の控え（30 日）や中身が残っている番号では作れない（B2）。作れると、控えを書き換えたり
        // 消し残しを読めたりした。たまたま当たったら、アプリが番号を振り直す（src/LoginScreen.js の 団体を作る）
        && !exists(/databases/$(database)/documents/deleted_accounts/$(groupId))
        && !exists(/databases/$(database)/documents/groups/$(groupId))
        && request.resource.data.email == callerEmail()
        && request.resource.data.id == groupId
        // ログインに要る2つと、確認済みの印だけ。同意の記録は private/consent へ書く
        //（src/legalDocs.js の 同意の記録。ここに混ぜると誰でも読める）
        && request.resource.data.keys().hasOnly(['id', 'email', 'verified']);

      // 更新にも hasOnly を掛ける。作るときだけ絞っても、あとから書き足せては
      // 意味がない。2026-09-03、検証環境で seed-stg.mjs が name と createdAt を
      // 書き戻せてしまい気づいた（作成は弾かれるが、更新は通っていた）。
      // ここが開いていると、団体の持ち主が自分で「学校名とメールの組」を
      // 誰でも読める場所に戻せる。
      allow update: if isAdmin()
        // 持ち主が直せるのは、ログインに要る2つと、切り替え待ちのアドレス（pendingEmail）だけ。
        // email そのものは変えさせない。切り替えは新しいアドレスの確認を通す（下の句）。
        // 直接変えられると、確かめていないアドレスに団体を渡せてしまう。
        // 前のアドレス（previousEmail）と口座の番号（ownerUid）は、消せるが書き換えられない
        // 切り替えを頼んだ口座の番号（pendingUid）は、自分の番号だけ書ける（切り替えの途中の本人を見分ける。上の sameOwnerAccount）
        || (sameOwnerAccount(resource.data)
            && request.resource.data.keys().hasOnly(['id', 'email', 'pendingEmail', 'pendingUid', 'previousEmail', 'ownerUid', 'verified'])
            && request.resource.data.get('pendingUid', request.auth.uid) == request.auth.uid
            && request.resource.data.email == resource.data.email
            // 確認済みの印を付けられるのは、確認の済んだメールで入っている本人だけ（付いている印はそのまま残せる）
            && (request.resource.data.get('verified', false) == resource.data.get('verified', false)
                || (request.resource.data.get('verified', false) == true && request.auth.token.email_verified == true))
            && request.resource.data.get('id', '') == resource.data.get('id', '')
            && (!('previousEmail' in request.resource.data)
                || request.resource.data.previousEmail == resource.data.get('previousEmail', ''))
            && (!('ownerUid' in request.resource.data)
                || request.resource.data.ownerUid == resource.data.get('ownerUid', '')))
        // 切り替えの仕上げ。確認のリンクを開いて新しいアドレスになった本人が、email を自分に
        // 書き換えて切り替え待ちを消す（src/groupLogin.js の 団体で入る）。
        // 確認済み（email_verified）でなければ通さない。通すと、切り替え待ちのアドレスで
        // 勝手に口座を作った人が団体を乗っ取れる（pendingEmail は誰でも読める）。
        // 前のアドレス（いまの email）と自分の口座の番号を残す。「元に戻す」に備える（下の句）
        || (callerEmail() != ''
            && request.auth.token.email_verified == true
            && !disposableEmail()
            && !disposableDomain()
            && resource.data.get('pendingEmail', '') == callerEmail()
            && request.resource.data.keys().hasOnly(['id', 'email', 'previousEmail', 'ownerUid', 'verified'])
            && request.resource.data.email == callerEmail()
            && request.resource.data.get('previousEmail', '') == resource.data.email
            && request.resource.data.get('ownerUid', '') == request.auth.uid
            && request.resource.data.get('id', '') == resource.data.get('id', ''))
        // 「元に戻す」のあと。古いアドレスに届くリンクで認証のアドレスが前のものに戻った本人が、
        // email を前のアドレスへ戻す。仕上げのときに残した口座の番号と同じ口座にしか通さない。
        // 前のアドレスで勝手に口座を作った人は、口座の番号が違うので通らない
        //（戻したあとに確認済みになるかは確かめられなかったので、email_verified には頼らない）
        || (callerEmail() != ''
            && resource.data.get('ownerUid', '') == request.auth.uid
            && resource.data.get('previousEmail', '') == callerEmail()
            && request.resource.data.keys().hasOnly(['id', 'email', 'verified'])
            && (request.resource.data.get('verified', false) == false || request.auth.token.email_verified == true)
            && request.resource.data.email == callerEmail()
            && request.resource.data.get('id', '') == resource.data.get('id', ''));

      // 消すのは管理者か、団体の持ち主本人（設定の「アカウントを削除する」。
      // src/accountDeletion.js が、写しを deleted_accounts に書いてから最後に消す）
      allow delete: if isAdmin() || sameOwnerAccount(resource.data);

      // 団体名・登録日・同意の記録。**その団体のメールアドレスで入っている
      // 本人だけ**が読み書きする。親の email と突き合わせて確かめる
      match /private/{doc} {
        allow read, write: if isAdmin()
          || ((verifiedEmail() || (callerEmail() != '' && inGracePeriod()))
              && sameOwnerAccount(get(/databases/$(database)/documents/group_accounts/$(groupId)).data));
      }
    }

    // 所属クレーム。書くのは中継（kyudo-chukei の POST /kojin）だけ（H1・2026-11-04）。
    // 中継が、匿名の口座の証・回数の上限（通信元ごと・団体ごと）・App Check の印を確かめてから、
    // サービスアカウントで逆引き表を引き、ここの前の決まりと同じこと（6 字か 12/2 までの 4 桁か・招待の期限・
    // 団体の確認済みか猶予中か）を確かめて書く。前は端末が書いていたので、匿名の口座をいくらでも作って
    // 逆引き表を総当たりでき、回数の上限も掛けられなかった（決まりは失敗を数えられない）。
    // 端末は自分の証を読む（自分の個人IDを出す）・消す（ログアウト）だけ
    match /member_claims/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if false;
    }

    // ライブの合言葉（groups/{団体}.liveSecret）を部員が足してよいか。まだ無いとき（空・字でない）だけ。
    // 足すだけで、書き換えはさせない（替わると、古い合言葉の端末と別の枝を見てライブが割れる）
    function addsLiveSecretOnly(groupId) {
      return isClaimedMember(groupId)
        && request.resource.data.get('liveSecret', '') is string
        && request.resource.data.get('liveSecret', '').size() >= 16
        && (resource == null
            ? request.resource.data.keys().hasOnly(['liveSecret'])
            : (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liveSecret'])
               && !(resource.data.get('liveSecret', null) is string && resource.data.get('liveSecret', '').size() >= 16)));
    }

    // 名簿・卒業生の文書に個人ID（personalId）を足す・変えることは断る。個人ID は逆引き表（member_lookup）にだけ置く
    // （C・2026-11-04。名簿は部員も読めるので、全員の個人ID が見えていた）。残っているものを消す・そのまま残すのは通す
    function keepsPersonalIdOut() {
      return !('personalId' in request.resource.data)
        || (resource != null && request.resource.data.personalId == resource.data.get('personalId', null));
    }

    match /groups/{groupId} {
      allow get: if canAccess(groupId);
      // 団体名などは団体だけ。部員はライブの合言葉がまだ無いときに足すだけ（B5）
      allow create, update: if isGroupOwner(groupId) || addsLiveSecretOnly(groupId);
      allow delete: if isGroupOwner(groupId);
      // list は書かない。団体の一覧化を防ぐ（SEC-5）

      // 個人ID→memberId の逆引き。読み書きは団体の持ち主だけ（H1・2026-11-04）。
      // 部員が入るときに引くのは中継（サービスアカウント）。前は匿名の口座なら誰でも 1 件ずつ引けたので、
      // 個人ID が合っているかを回数の上限なしに試せた（SEC-6 の list の禁止はそのまま）
      // 書くのは新しい版の形（形 == 2）だけ。端末からは消させない（消すときは「消した」印に書き換える。src/kojinId.js）。
      // 前の版の端末（開いたままのタブ）は、名簿に個人ID が無いのを見ると行を全部消して作り直し、全員が入れなくなった
      // （2026-11-07 のレビュー）。消せるのは団体を消す途中だけ（写しの deleted_accounts/{団体} を先に書く。src/accountDeletion.js）
      match /member_lookup/{personalId} {
        allow read: if isGroupOwner(groupId);
        allow create, update: if isGroupOwner(groupId) && request.resource.data.get('形', 0) == 2;
        allow delete: if isGroupOwner(groupId)
          && exists(/databases/$(database)/documents/deleted_accounts/$(groupId));
      }

      // 部員（個人ログイン）が書けるのは、記録を作る・直すと、自分の名簿の弓具だけ。記録を消す・名簿を作る・消す・
      // ゴミ箱・卒業生・練習日は団体だけ（2026-11-02 決めた）。読むのは部員も今のまま。
      // アプリも部員にはこれらの操作を出していない（履歴の削除は管理者モード・出欠のタブは団体だけ・
      // 部員の端末は自分の弓具だけ送る src/storeMembers.js の 弓具だけ送る形）
      // 部員が記録を直すときは、射手を減らさない（アプリも部員の端末では減らさない。src/storeSessions.js の updateSession）。
      // アプリを通さずに書かれても、射手を消して記録を潰せないように（B5）
      match /sessions/{docId} {
        allow read, create: if canAccess(groupId);
        allow update: if isGroupOwner(groupId)
          || (isClaimedMember(groupId)
              && request.resource.data.get('archers', []) is list
              && request.resource.data.get('archers', []).size() >= resource.data.get('archers', []).size());
        allow delete: if isGroupOwner(groupId);
      }
      match /members/{docId} {
        allow read: if canAccess(groupId);
        allow create: if isGroupOwner(groupId) && keepsPersonalIdOut();
        allow delete: if isGroupOwner(groupId);
        allow update: if (isGroupOwner(groupId) && keepsPersonalIdOut())
          || (isClaimedMember(groupId)
              && docId == claim().data.memberId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equipments', 'lastModified']));
      }
      match /alumni/{docId} {
        allow read: if canAccess(groupId);
        allow create, update: if isGroupOwner(groupId) && keepsPersonalIdOut();
        allow delete: if isGroupOwner(groupId);
      }
      match /trash/{docId} {
        allow read: if canAccess(groupId);
        allow write: if isGroupOwner(groupId);
      }
      // config のうち listing（紹介に載せてよいかの許可・2026-10-09）は、団体の持ち主だけが書ける。
      // 部員の端末から団体の答えを変えられないように。読むのは部員も可（画面には出さない）。src/listingConsent.js
      // 設定（団体の種類・進級の確認・1 年生の期・順位の基準など）を書けるのは団体だけ。部員が足せるのは
      // 目印（タグ）の候補だけ（アプリも部員の端末ではタグの候補だけ送る。src/useScoreStore.js の 目印の候補を置く。B5）
      match /config/{docId} {
        allow read: if canAccess(groupId);
        allow write: if docId != 'listing'
          && (isGroupOwner(groupId)
              || (isClaimedMember(groupId)
                  && docId == 'app_settings'
                  && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['tagTemplates', 'lastModified'])));
      }
      match /config/listing {
        allow read: if canAccess(groupId);
        allow write: if isGroupOwner(groupId);
      }
      match /officialPracticeDays/{docId} {
        allow read: if canAccess(groupId);
        allow write: if isGroupOwner(groupId);
      }
    }

    // 使い捨てメールのドメインの一覧（上の disposableDomain）。一覧は秘密でないので誰でも 1 件ずつ引ける
    // （アプリが口座を作る前に引いて断る）。書くのは運営の台本だけ（所有者のトークンは決まりを通らない）
    match /disposable_domains/{domain} {
      allow get: if true;
      allow list, write: if false;
    }

    // 消した団体アカウントの写し。設定の「アカウントを削除する」で、団体の持ち主が
    // 自分の団体の中身をここへ写してから元を消す（src/accountDeletion.js）。
    // 30日残して運営者の道具（scripts/prune-deleted-accounts.mjs）が消す。
    // 読めるのは管理者だけ。持ち主も、写したあとは読めない（消したものは戻せない）。
    // 書けるのは自分の団体IDの下だけ。group_accounts が残っているうちに書く順になっている
    match /deleted_accounts/{groupId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() || isGroupOwner(groupId);
      allow delete: if isAdmin();
      match /{sub}/{docId} {
        allow read: if isAdmin();
        allow create, update: if isAdmin() || isGroupOwner(groupId);
        allow delete: if isAdmin();
      }
    }

    // 送った時刻の控え（1 人 1 文書。2026-11-03）。お問い合わせと不具合の便りを続けて送れないようにする。
    // 書けるのは本人だけで、値は「今」（request.time）か、触らずに残すかだけ。昔の時刻にずらして回数を逃れられない
    match /rate_limits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['inquiryAt', 'reportAt'])
        && (request.resource.data.get('inquiryAt', null) == request.time
            || request.resource.data.get('inquiryAt', null) == (resource == null ? null : resource.data.get('inquiryAt', null)))
        && (request.resource.data.get('reportAt', null) == request.time
            || request.resource.data.get('reportAt', null) == (resource == null ? null : resource.data.get('reportAt', null)));
    }
    // 前に送った時刻（無ければ十分昔）から、間隔が空いているか。今送る分は、同じ一括で控えを「今」にしてあること
    function enoughGap(field, secs) {
      return getAfter(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.get(field, null) == request.time
        && (!exists(/databases/$(database)/documents/rate_limits/$(request.auth.uid))
            || get(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.get(field, timestamp.value(0)) < request.time - duration.value(secs, 's'));
    }

    // 不具合の便り。書き込みだけ許し、読み出しは誰にも許さない。
    // 送り主が自分の送ったものを読めると、他人の端末の様子まで見えてしまう。
    // 中身は src/errorReport.js が組む。氏名・的中は入れない決まり。
    match /errorReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'id', 'at', 'where', 'message', 'code', 'stack', 'trail',
             'groupId', 'role', 'version', 'device', 'online', 'count',
             'createdAt', 'expireAt'
           ])
        && request.resource.data.message is string
        && request.resource.data.message.size() < 1000
        && request.resource.data.stack.size() < 4000
        && request.resource.data.trail.size() <= 30
        && request.resource.data.device.size() < 400
        // 1 人 10 秒に 1 件まで（アプリは同じ不具合をまとめて送るので、ふつうは届かない。アプリを通さずに送る荒らしを止める）
        && enoughGap('reportAt', 10);
      allow read, update, delete: if false;
    }

    match /inquiries/{inquiryId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'email', 'content', 'imagesBase64', 'createdAt',
             'groupId', 'groupName', 'role', 'memberId', 'memberName'
           ])
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() < 5000
        // 送れるのは団体の持ち主と所属の証のある部員だけ（共有リンクの来客・匿名だけの人は送れない）・1 人 2 分に 1 件まで
        && canAccess(request.resource.data.groupId)
        && enoughGap('inquiryAt', 120);
      allow read, update, delete: if false;
    }
  }
}

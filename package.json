{
  "name": "recordappexpo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "deploy:web": "expo export --platform web && powershell -Command \"(gc dist/index.html) -replace '<script src=', '<script type=\\\"module\\\" src=' | Out-File -encoding utf8 dist/index.html\" && firebase deploy --only hosting"
  },

{
  "name": "recordappexpo",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "tsc -p tsconfig.check.json && eslint --config eslint.undef.mjs \"src/**/*.js\" App.js && node --test test/*.test.js",
    "deploy:web": "node scripts/build-prod.mjs && powershell -ExecutionPolicy Bypass -File scripts/deploy-web.ps1 && firebase deploy --only hosting --project kyudoscoremanager",
    "deploy:rules": "firebase deploy --only database,firestore:rules --project kyudoscoremanager",
    "lint": "eslint src/TutorialGuide.js src/tutorialSteps.js src/WhatsNewModal.js scripts test",
    "build:stg": "node scripts/build-stg.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "stg:status": "node scripts/stg-status.mjs",
    "deploy:rules:stg": "firebase deploy --only database,firestore:rules --project kyudoscoremanager-stg",
    "ops:check": "node scripts/check-release-state.mjs prod",
    "ops:audit": "node scripts/audit-prod-data.mjs prod",
    "ops:lookup": "node scripts/check-lookup-drift.mjs prod",
    "ops:backup": "node scripts/backup-prod.mjs prod",
    "ops:accept": "node scripts/verify-prod-acceptance.mjs",
    "ops:orphans": "node scripts/find-orphan-accounts.mjs prod",
    "ops:reports": "node scripts/read-error-reports.mjs prod",
    "ops:prune-live": "node scripts/prune-old-live-branches.mjs prod",
    "ops:prune-live:run": "node scripts/prune-old-live-branches.mjs prod 消す",
    "ops:prune-reports": "node scripts/prune-error-reports.mjs prod",
    "ops:prune-reports:run": "node scripts/prune-error-reports.mjs prod 消す",
    "typecheck": "tsc -p tsconfig.check.json",
    "ops:expiry-rules": "node scripts/check-share-expiry-rules.mjs",
    "ops:scan-japanese": "node scripts/scan-japanese-strings.mjs",
    "lint:undef": "eslint --config eslint.undef.mjs \"src/**/*.js\" App.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.9",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@google/generative-ai": "^0.24.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-firebase/app": "^19.1.1",
    "@react-native-firebase/auth": "^19.1.1",
    "@react-native-firebase/database": "^19.1.1",
    "@react-native-firebase/firestore": "^19.1.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "date-fns": "^4.1.0",
    "expo": "~55.0.28",
    "expo-build-properties": "~55.0.16",
    "expo-clipboard": "~55.0.15",
    "expo-constants": "~55.0.17",
    "expo-document-picker": "~55.0.15",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-image-manipulator": "~55.0.19",
    "expo-image-picker": "~55.0.22",
    "expo-linking": "~55.0.16",
    "expo-modules-core": "~55.0.22",
    "expo-sharing": "~55.0.22",
    "expo-status-bar": "~55.0.6",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "firebase": "^12.18.0",
    "lucide-react-native": "^1.8.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@react-native-community/cli": "^15.0.1",
    "@react-native/metro-config": "^0.85.0",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.17",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },

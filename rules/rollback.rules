// 復旧用ルール（NFR-3）
//
// ■ 使い方
//   本番で「部員が自分の団体を開けない」といった問題が起きたときに、
//   この内容を firestore.rules へ上書きコピーして配る。
//
//     cp rules/rollback.rules firestore.rules
//     npx firebase deploy --only firestore:rules --project kyudoscoremanager
//
// ■ 何を緩めるか
//   所属の証明（member_claims / isClaimedMember）だけを外す。
//   部員は signInAnonymously で入り、member_lookup と member_claims で
//   所属を証明している。この仕組みが原因で誰も入れなくなったときに、
//   団体の中身を「認証済みなら通る」まで戻すのがここの目的。
//
// ■ 何を緩めないか（ここが要点）
//   group_accounts は緩めない。
//   2026-09-02 に、団体名・登録日・同意の記録が誰でも読める場所に
//   置かれていて、6桁の団体IDを順に試すだけで「学校名とその担当者の
//   メールアドレス」が組で集められることを本番で実際に確かめている。
//   匿名認証は公開APIキーだけで誰でも通せるため、ここを
//   「認証済みなら list できる」に戻すと、その流出がそのまま復活する。
//   同意の記録を置く private も、本人と管理者だけのままにする。
//
//   member_lookup の list 禁止（SEC-6）も外さない。外すと名簿が引ける。
//
// ■ 保守
//   2026-09-03 時点の firestore.rules をもとに作成。
//   firestore.rules を変えたら、こちらも合わせて見直すこと。
//   以前この控えは _archive に置かれていて git にも入っておらず、
//   中身が古いまま「コピーして配る」手順だけが残っていた。
//   気づかず配れば上の流出が戻るところだったので、repo へ移した。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function callerEmail() {
      return (signedIn() && ('email' in request.auth.token))
        ? request.auth.token.email : '';
    }

    // firestore.rules と同じ一覧にしておく（2026-09-03 に5件から1件へ減らした）
    function isAdmin() {
      return callerEmail() in [
        'nihonu.kouka@gmail.com'
      ];
    }

    function isGroupOwner(groupId) {
      return callerEmail() != ''
        && get(/databases/$(database)/documents/group_accounts/$(groupId)).data.email == callerEmail();
    }

    // ここが通常のルールとの違い。所属の証明を求めず、認証済みなら通す
    function canAccess(groupId) {
      return signedIn();
    }

    // 通常のルールとまったく同じにしておく（緩めない）
    match /group_accounts/{groupId} {
      allow get: if true;                        // ログインは認証前に参照する
      allow list: if isAdmin();

      allow create: if signedIn()
        && callerEmail() != ''
        && request.resource.data.email == callerEmail()
        && request.resource.data.id == groupId
        && request.resource.data.keys().hasOnly(['id', 'email']);

      allow update: if isAdmin()
        || (callerEmail() != ''
            && resource.data.email == callerEmail()
            && request.resource.data.keys().hasOnly(['id', 'email']));

      allow delete: if isAdmin();

      match /private/{doc} {
        allow read, write: if isAdmin()
          || (callerEmail() != ''
              && callerEmail() ==
                 get(/databases/$(database)/documents/group_accounts/$(groupId)).data.email);
      }
    }

    // 所属クレームは残す。作れなくなっていても、上の canAccess が
    // 見ていないので入れなくなることはない
    match /member_claims/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['groupId', 'memberId', 'personalId', 'claimedAt'])
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/member_lookup/$(request.resource.data.personalId)).data.memberId
             == request.resource.data.memberId;
    }

    match /groups/{groupId} {
      allow get: if canAccess(groupId);
      allow create, update: if canAccess(groupId);
      allow delete: if isGroupOwner(groupId);
      // list は書かない。団体の一覧化を防ぐ（SEC-5）

      // list 禁止は外さない。外すと名簿が引ける（SEC-6）
      match /member_lookup/{personalId} {
        allow get: if signedIn();
        allow list, write: if isGroupOwner(groupId);
      }

      match /sessions/{docId}             { allow read, write: if canAccess(groupId); }
      match /members/{docId}              { allow read, write: if canAccess(groupId); }
      match /alumni/{docId}               { allow read, write: if canAccess(groupId); }
      match /trash/{docId}                { allow read, write: if canAccess(groupId); }
      match /config/{docId}               { allow read, write: if canAccess(groupId); }
      match /officialPracticeDays/{docId} { allow read, write: if canAccess(groupId); }
    }

    match /errorReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'id', 'at', 'where', 'message', 'code', 'stack', 'trail',
             'groupId', 'role', 'version', 'device', 'online', 'count',
             'createdAt', 'expireAt'
           ])
        && request.resource.data.message is string
        && request.resource.data.message.size() < 1000
        && request.resource.data.stack.size() < 4000
        && request.resource.data.trail.size() <= 30
        && request.resource.data.device.size() < 400;
      allow read, update, delete: if false;
    }

    match /inquiries/{inquiryId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'email', 'content', 'imagesBase64', 'createdAt',
             'groupId', 'groupName', 'role', 'memberId', 'memberName'
           ])
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() < 5000;
      allow read, update, delete: if false;
    }
  }
}

// 検証用プロジェクト(stg)へ合成データを投入するためだけの一時ルール。
// Firestore を本番環境モードで作ったため既定は全拒否で、投入できない。
//
//   npx firebase deploy --only firestore:rules --project stg   ※firebase.json を切り替えて使う
//
// 投入が終わったら必ず rules/stage1.rules に差し替えること。
// 本番へは絶対にデプロイしない。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
